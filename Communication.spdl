hashfunction H;

usertype ConstVal;
usertype key;
usertype Nonce;
usertype Agent;

const Username: ConstVal;
const Password: ConstVal;
const STCN: ConstVal;

const Biometric : ConstVal;
var Ru;
const XOR : Function;

protocol UDCNUAV(UD, CN, UAV)
{
    role UD
    {
        fresh a1: Nonce;
        fresh a1: Nonce;
        fresh a2 : Nonce;
        fresh  Stu : Nonce;   //  current timestamp  request send UD

        const pk: key;
        const Ru: Nonce;

        send_1(UD, CN, UD, XOR(H(Ru, Stu), (a1, Ru)),H(a2,Ru,pk),H(a1,a2,Ru,Stu),Stu);  //Au4,Au5,sign1

        recv_4(CN, UD,H(Ru,UD,Stu,pk)); //auth from CN
        claim_UD1(UD,Alive);
        claim_UD2(UD,Nisynch);
        claim_UD3(UD, Niagree);
    }

    role CN
    {

        var a1 : Nonce;
        var a2 : Nonce;
        var Stu : Nonce;
        fresh c1: Nonce;
        fresh Stcn: Nonce; // time at cN send message to UAV
        const pk : key;

        recv_1(UD, CN,UD,XOR(H(Ru,Stu),(a1,Ru)),H(a2,Ru,pk),H(a1,a2,Ru,Stu),Stu);

        send_2(CN, UAV,XOR(H(Ru,CN),(Stcn)),H(c1,CN),CN,Stcn);


        var a : Nonce;
        var Std : Nonce;

        recv_3(UAV, CN,XOR(H(Ru,UAV),(a2,Std)),H(a2,Ru),UAV,Std);
         send_4(CN, UD, H(Ru,UD,Stu,pk));


      send_5(CN,UAV,H(Ru,UAV,Std));

        claim_CN1(CN,Alive);
        claim_CN2(CN,Nisynch);
        claim_CN3(CN,Niagree);
    }

    role UAV
    {

        var c1 : Nonce;
        var Stcn : Nonce;
        fresh a2 : Nonce;
        fresh Std: Nonce;

         recv_2(CN, UAV,XOR(H(Ru,CN),(Stcn)),H(c1,CN),CN,Stcn);
        send_3(UAV, CN,XOR(H(Ru,UAV),(a2,Std)),H(a2,Ru),UAV,Std);
        recv_5(CN,UAV,H(Ru,UAV,Std));

        claim_UAV1(UAV,Alive);
        claim_UAV2(UAV,Nisynch);
        claim_UAV3(UAV,Niagree);

    }
}